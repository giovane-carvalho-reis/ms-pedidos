# ============================================================
# .env.example - ms-pedidos
# ============================================================
# Arquivo de exemplo com as variáveis de ambiente necessárias.
#
# Como usar:
# 1. Copie este arquivo para .env:
#    cp .env.example .env
# 2. Preencha os valores corretos para o seu ambiente
#
# ⚠️ NUNCA commite o arquivo .env no repositório!
#    O .gitignore já está configurado para ignorá-lo.
# ============================================================

# Ambiente da aplicação
# Valores possíveis: development | production | test
NODE_ENV=development

# Porta em que o serviço irá escutar
PORT=3000

# ===================
# Banco de Dados PostgreSQL
# ===================

# Host do banco de dados
# Em desenvolvimento local: localhost
# Com Docker Compose: postgres (nome do serviço no docker-compose.yml)
DB_HOST=localhost

# Porta do PostgreSQL (padrão: 5432)
DB_PORT=5432

# Nome do usuário do banco de dados
DB_USERNAME=postgres

# Senha do usuário do banco de dados
# ⚠️ Em produção, use uma senha forte e armazene de forma segura!
DB_PASSWORD=postgres

# Nome do banco de dados
DB_DATABASE=ms_pedidos
